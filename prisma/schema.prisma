generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform accounts
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash    String
  name            String
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  sessions     Session[]
  business     Business?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Tenant: one rental business = one storefront
// ---------------------------------------------------------------------------

model Business {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  tagline      String  @default("")
  description  String  @default("")
  logoUrl      String  @default("")
  heroImageUrl String  @default("")
  primaryColor String  @default("#0f766e")
  currency     String  @default("USD")
  email        String  @default("")
  phone        String  @default("")
  address      String  @default("")
  taxRate      Float   @default(0) // percent, e.g. 8.25

  // Social links shown on the storefront
  facebookUrl  String @default("")
  instagramUrl String @default("")
  tiktokUrl    String @default("")

  // Knowledge base the support bot uses (policies, FAQ, hours...)
  policies    String  @default("")
  botEnabled  Boolean @default(true)
  botName     String  @default("Rental Assistant")
  botGreeting String  @default("Hi! I can check availability, explain our policies, or look up an order. How can I help?")

  // Reminder agent settings
  remindBeforeDays  Int     @default(1)
  remindOverdue     Boolean @default(true)
  remindPaymentDue  Boolean @default(true)
  autoSendReminders Boolean @default(false)
  lowStockThreshold Int     @default(2)

  // Platform administration
  suspended  Boolean @default(false)
  adminNotes String  @default("")

  // Custom domain (e.g. www.peakgear.com) pointing at this storefront
  customDomain         String?   @unique
  customDomainVerified Boolean   @default(false)
  customDomainAddedAt  DateTime?

  // Stripe Connect (the business's own Stripe account; direct charges)
  country              String  @default("US")
  stripeAccountId      String? @unique
  stripeChargesEnabled Boolean @default(false)
  stripeOnboarded      Boolean @default(false)

  // Stripe Billing (the business's RentFlow subscription)
  planKey            String?
  subscriptionId     String?   @unique
  subscriptionStatus String? // trialing | active | past_due | canceled | unpaid | incomplete
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories    Category[]
  items         Item[]
  customers     Customer[]
  orders        Order[]
  payments      Payment[]
  reminders     Reminder[]
  conversations Conversation[]
  agentRuns     AgentRun[]
  domainPurchases DomainPurchase[]
}

/// A domain bought through RentFlow (registered via Vercel's registrar).
/// status: pending_payment | paid | purchasing | completed | failed | refunded
model DomainPurchase {
  id                    String    @id @default(cuid())
  businessId            String
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  domain                String
  years                 Int       @default(1)
  vercelPrice           Int // cents RentFlow pays the registrar
  renewalPrice          Int       @default(0) // cents, informational
  price                 Int // cents the business pays
  currency              String    @default("USD")
  status                String    @default("pending_payment")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  vercelOrderId         String?
  error                 String    @default("")
  contactJson           String    @default("{}")
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([businessId, status])
}

model Category {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  items      Item[]

  @@unique([businessId, name])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Item {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  slug        String
  sku         String    @default("")
  description String    @default("")
  imageUrl    String    @default("")
  pricePerDay Int // cents
  deposit     Int       @default(0) // cents
  quantity    Int       @default(1)
  minDays     Int       @default(1)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItems  OrderItem[]

  @@unique([businessId, slug])
  @@index([businessId, active])
}

// ---------------------------------------------------------------------------
// Customers & orders
// ---------------------------------------------------------------------------

model Customer {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  email         String
  phone         String         @default("")
  notes         String         @default("")
  createdAt     DateTime       @default(now())
  orders        Order[]
  reminders     Reminder[]
  conversations Conversation[]

  @@unique([businessId, email])
}

/// status: PENDING | CONFIRMED | ACTIVE | RETURNED | CANCELLED
model Order {
  id          String      @id @default(cuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  orderNumber Int
  status      String      @default("PENDING")
  startDate   DateTime
  endDate     DateTime
  subtotal    Int // cents
  deposit     Int         @default(0)
  tax         Int         @default(0)
  total       Int
  notes       String      @default("")
  source      String      @default("storefront") // storefront | manual | bot
  // Where the rental is delivered / the service happens. "pickup" = customer collects in store.
  fulfillment  String @default("delivery") // delivery | pickup
  addressLine1 String @default("")
  addressLine2 String @default("")
  city         String @default("")
  region       String @default("")
  postalCode   String @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
  payments    Payment[]
  reminders   Reminder[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status])
  @@index([businessId, startDate])
  @@index([businessId, endDate])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item   @relation(fields: [itemId], references: [id])
  quantity  Int
  unitPrice Int // cents per day at time of order
  days      Int
  lineTotal Int
}

/// method: stripe | simulated | cash | card | bank | other
/// status: pending | paid | refunded | failed
model Payment {
  id                    String    @id @default(cuid())
  businessId            String
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount                Int // cents
  currency              String
  method                String
  status                String    @default("pending")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  stripeAccountId       String? // connected account the charge lives on
  applicationFee        Int       @default(0) // platform fee in cents
  note                  String    @default("")
  paidAt                DateTime?
  createdAt             DateTime  @default(now())

  @@index([businessId, status])
}

/// Every email the platform sends (or would send in demo mode).
/// status: sent | logged | failed
model EmailLog {
  id         String   @id @default(cuid())
  businessId String?
  kind       String // order_confirmation | payment_receipt | refund | order_status | reminder | owner_new_order | test
  to         String
  subject    String
  text       String
  html       String   @default("")
  status     String
  providerId String   @default("")
  error      String   @default("")
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

/// Processed Stripe webhook events, for idempotency.
model StripeEvent {
  id          String   @id
  type        String
  account     String?
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// AI reminder agent
// ---------------------------------------------------------------------------

/// type: pickup | return | overdue | payment_due | custom
/// status: draft | approved | sent | failed | skipped
model Reminder {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         String
  channel      String    @default("email")
  scheduledFor DateTime
  subject      String
  body         String
  status       String    @default("draft")
  aiGenerated  Boolean   @default(false)
  deliveryNote String    @default("")
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([orderId, type])
  @@index([businessId, status])
}

model AgentRun {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  trigger    String // manual | cron | schedule
  summary    String
  created    Int      @default(0)
  sent       Int      @default(0)
  usedAi     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Customer-service bot
// ---------------------------------------------------------------------------

model Conversation {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  visitorId  String
  escalated  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]

  @@index([businessId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  createdAt      DateTime     @default(now())
}
