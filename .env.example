# Copy to .env and fill in what you have. Everything except DATABASE_URL is optional:
# the app runs fully in "demo mode" without the AI, Stripe, or SMTP keys.

# Postgres connection string (Neon, Supabase, Vercel Postgres, local Postgres...).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public base URL, used in emails and Stripe redirect links.
APP_URL="http://localhost:3000"

# Comma-separated emails that can open the platform admin at /admin.
# Admins can also be granted from /admin/users once one admin exists.
PLATFORM_ADMIN_EMAILS="you@example.com"

# --- Custom domains (Vercel Domains API) --------------------------------
# Lets businesses connect their own domain from Settings. Create a token at
# https://vercel.com/account/tokens scoped to the team that owns the project.
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# --- AI (Claude) ---------------------------------------------------------
# Powers the customer-service bot and the reminder agent. Without it the bot
# falls back to a rule-based responder and reminders use templates.
ANTHROPIC_API_KEY=""
# Model used for both the bot and the reminder agent.
CLAUDE_MODEL="claude-opus-5"

# --- Stripe: Payments (Connect) + Billing --------------------------------
# Without a secret key, checkout uses a built-in simulated payment page and
# billing is not enforced. Prefer a restricted key (rk_...) over sk_...
# Never commit real keys; on Vercel store them as Sensitive env vars.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Platform webhook (/api/webhooks/stripe) and Connect webhook (/api/webhooks/stripe/connect).
# `npm run stripe:setup -- --webhooks https://your-app` creates both and prints the secrets.
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Subscription prices created by `npm run stripe:setup`.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
# Platform fee kept from each rental payment (percent).
PLATFORM_FEE_PERCENT="5"

# --- Email (SMTP) --------------------------------------------------------
# Without these, reminders are marked "sent" and stored in the outbox only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RentFlow <no-reply@example.com>"

# --- Reminder agent scheduling ------------------------------------------
# Protects /api/cron/reminders when called by an external scheduler.
CRON_SECRET="change-me"
# When set (minutes), the dev server runs the reminder agent on a timer.
REMINDER_AGENT_INTERVAL_MINUTES="30"
