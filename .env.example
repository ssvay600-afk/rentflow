# Copy to .env and fill in what you have. Everything except DATABASE_URL is optional:
# the app runs fully in "demo mode" without the AI, Stripe, or SMTP keys.

# Postgres connection string (Neon, Supabase, Vercel Postgres, local Postgres...).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public base URL, used in emails and Stripe redirect links.
APP_URL="http://localhost:3000"

# --- AI (Claude) ---------------------------------------------------------
# Powers the customer-service bot and the reminder agent. Without it the bot
# falls back to a rule-based responder and reminders use templates.
ANTHROPIC_API_KEY=""
# Model used for both the bot and the reminder agent.
CLAUDE_MODEL="claude-opus-5"

# --- Payments (Stripe) ---------------------------------------------------
# Without these, checkout uses a built-in simulated payment page.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (SMTP) --------------------------------------------------------
# Without these, reminders are marked "sent" and stored in the outbox only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RentFlow <no-reply@example.com>"

# --- Reminder agent scheduling ------------------------------------------
# Protects /api/cron/reminders when called by an external scheduler.
CRON_SECRET="change-me"
# When set (minutes), the dev server runs the reminder agent on a timer.
REMINDER_AGENT_INTERVAL_MINUTES="30"
